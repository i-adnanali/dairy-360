node_modules/
dist/
*.log

# env
.env

# sqlite database + WAL sidecar files
*.db
*.db-shm
*.db-wal

# Registry backups (`npm run registry:backup -w server`). The .db snapshots are
# already covered by *.db above; this also excludes the .sql dumps, which are
# text and would otherwise look committable.
#
# THIS EXCLUSION IS DELIBERATE AND SHOULD STAY, for two reasons in this order:
#
#   1. A backup must not share a fate with the thing it backs up. A force-push, a
#      bad `reset` or a lost account should not take the herd records with it.
#      This reason does not depend on a setting anyone can change.
#   2. This repository is public, and the dumps hold real herd records.
#
# Reason 1 is listed first on purpose: if this repo ever goes private, reason 2
# stops applying and reason 1 still decides it.
#
# Copies go to the separate backup repo instead -- ~/dairy-registry-backups,
# filled daily by scripts/backup-daily.sh. That repo is LOCAL ONLY today: it gives
# per-day history but no protection against losing the machine. If it is ever
# given a remote, that remote must be PRIVATE. See docs/DEVELOPMENT.md § 8.
server/backups/

# Cycle 7 live-camera capture artifacts + local Frigate config.
# The capture is throwaway data (open decision 1: the shared dev DB stays
# untouched, so captures land in flat files instead). The Frigate config holds
# the camera's LAN address and RTSP credentials -- see the security note in
# docs/cycle-7-live-camera-validation.md. Only the .example stays tracked.
server/captures/
frigate/config.yml

# Cycle 7 FU-3 (Double Take). The local config is gitignored for the same
# reason frigate/config.yml is -- it gets edited during a window and those
# edits are noise on a committed file. Only the .example stays tracked.
#
# double-take/enroll/ holds the SYNTHETIC portrait enrolled as the sole gallery
# subject. It is deliberately not committed: the repo is public, and a face
# image in git is a face image in git even when the face is machine-generated.
# See docs/Cycle7-fu3-double-take-validation.md § open decision 1 for the
# provenance requirement and enroll/README.md for how to supply one.
double-take/config.yml
double-take/enroll/*
!double-take/enroll/README.md
# PROVENANCE.txt IS tracked, deliberately: it holds no image data, and it is the
# durable record of why enrolling this face was acceptable at all. The image it
# describes is gone after the window; the justification should not be.
!double-take/enroll/PROVENANCE.txt

# os
.DS_Store

# JetBrains IDE
.idea/
