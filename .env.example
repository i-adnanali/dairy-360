ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6
PORT=4000

# Langfuse (self-hosted) observability.
# Start the stack with: docker compose -f docker-compose.langfuse.yml up -d
# Then open http://localhost:3000, create a project, and paste its keys here.
# If these are unset, tracing is silently disabled and the agent runs normally.
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Cycle 7 step 1 — live camera payload-shape validation (throwaway).
# See docs/cycle-7-live-camera-validation.md.
# ---------------------------------------------------------------------------
# LAN-local secrets: the camera's address and RTSP credentials. Required by
# docker-compose.frigate.yml, which fails fast with a named error if any is
# unset rather than letting Frigate start with an unusable RTSP URL.
# `.env` is gitignored; never move these into frigate/config.yml.
# May include a port (`192.168.x.x:554`). The RTSP URL is built without a
# hardcoded port, so ffmpeg's default of 554 applies when none is given.
FRIGATE_CAM_HOST=192.168.x.x
FRIGATE_CAM_USER=your-camera-user
FRIGATE_CAM_PASS=your-camera-password
# Yoosee A10 stream path. RESOLVED by probing the camera's SDP directly:
#   /onvif1 (main) = 1280x720, H.264 Baseline level 3.1, + PCMA/16000 audio
#   /onvif2 (sub)  =  320x180, H.264 Baseline level 2.0, video only
# Use /onvif1. The sub-stream's 320x180 is too small for reliable person/car
# detection at street distance, and 720p @ 5fps is comfortable for a CPU
# detector. Note both streams advertise `H265/90000` in SDP while actually
# sending H.264 — a camera firmware bug that plain ffmpeg cannot survive; see
# the go2rtc block in frigate/config.example.yml.
FRIGATE_CAM_PATH=/onvif1
# Broker the host-side capture script connects to. Matches the compose stack's
# published port; only change this if you point Frigate at a different broker.
FRIGATE_MQTT_URL=mqtt://localhost:1883
