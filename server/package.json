{
  "name": "@dairy/server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "simulate:farm": "TZ=Asia/Karachi tsx src/farm/simulate.ts",
    "verify:farm": "TZ=Asia/Karachi tsx src/farm/verify.ts",
    "verify:classify": "TZ=Asia/Karachi tsx src/farm/verifyClassify.ts",
    "capture:frigate": "tsx src/farm/captureMqtt.ts",
    "verify:payload": "tsx src/farm/verifyPayloadShape.ts",
    "enroll:synthetic": "tsx src/farm/enrollSynthetic.ts",
    "capture:doubletake": "tsx src/farm/captureDoubleTake.ts",
    "verify:payload:dt": "tsx src/farm/verifyDoubleTakeShape.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/**/*.test.ts",
    "test:regression": "npm run test:regression:core && npm run test:regression:cap && npm run test:regression:fallback",
    "test:regression:core": "RUN_REGRESSION=1 tsx --test src/agent/__tests__/regression.test.ts",
    "test:regression:cap": "RUN_REGRESSION=1 AGENT_MAX_ITERATIONS=1 tsx --test src/agent/__tests__/regression.cap.test.ts",
    "test:regression:fallback": "RUN_REGRESSION=1 ANTHROPIC_MODEL=claude-not-a-real-model-999 tsx --test src/agent/__tests__/regression.fallback.test.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/encoder": "^0.0.57",
    "@anthropic-ai/sdk": "^0.32.1",
    "@dairy/shared": "*",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@opentelemetry/sdk-node": "^0.220.0",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "mqtt": "^5.15.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
