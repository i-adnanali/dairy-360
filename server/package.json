{
  "name": "@dairy/server",
  "version": "1.0.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed": "tsx src/seed.ts",
    "simulate:farm": "TZ=Asia/Karachi tsx src/farm/simulate.ts",
    "verify:farm": "TZ=Asia/Karachi tsx src/farm/verify.ts",
    "verify:classify": "TZ=Asia/Karachi tsx src/farm/verifyClassify.ts",
    "capture:frigate": "tsx src/farm/captureMqtt.ts",
    "verify:payload": "tsx src/farm/verifyPayloadShape.ts",
    "enroll:synthetic": "tsx src/farm/enrollSynthetic.ts",
    "capture:doubletake": "tsx src/farm/captureDoubleTake.ts",
    "verify:payload:dt": "tsx src/farm/verifyDoubleTakeShape.ts",
    "registry:add": "TZ=Asia/Karachi tsx src/registry/add.ts",
    "registry:event": "TZ=Asia/Karachi tsx src/registry/event.ts",
    "registry:calve": "TZ=Asia/Karachi tsx src/registry/calve.ts",
    "registry:correct-calving": "TZ=Asia/Karachi tsx src/registry/correct.ts",
    "registry:harness": "TZ=Asia/Karachi tsx src/registry/harness.ts",
    "registry:rebuild": "TZ=Asia/Karachi tsx src/registry/rebuild.ts",
    "verify:registry": "TZ=Asia/Karachi tsx src/registry/verifyRegistry.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "_test_note": "Test dirs are ENUMERATED, not globbed. `src/**/*.test.ts` is expanded by sh, where ** is NOT globstar, so it silently meant src/<dir>/<file> only -- correct by accident. Quoting it hands globbing to node, which DOES recurse and would pull in src/agent/__tests__/regression*.test.ts: those load ../db and report `ok # SKIP` without an API key, i.e. the API-gated suite reads as passing. node 22 has no --test-exclude-pattern (only name/skip patterns, which still LOAD the file). So: list the dirs, and let testWiring.test.ts fail loudly when a *.test.ts appears outside them.",
    "test": "tsx --test src/*.test.ts src/farm/*.test.ts src/registry/*.test.ts src/tools/*.test.ts",
    "test:regression": "npm run test:regression:core && npm run test:regression:cap && npm run test:regression:fallback",
    "test:regression:core": "RUN_REGRESSION=1 tsx --test src/agent/__tests__/regression.test.ts",
    "test:regression:cap": "RUN_REGRESSION=1 AGENT_MAX_ITERATIONS=1 tsx --test src/agent/__tests__/regression.cap.test.ts",
    "test:regression:fallback": "RUN_REGRESSION=1 ANTHROPIC_MODEL=claude-not-a-real-model-999 tsx --test src/agent/__tests__/regression.fallback.test.ts"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.57",
    "@ag-ui/encoder": "^0.0.57",
    "@anthropic-ai/sdk": "^0.32.1",
    "@dairy/shared": "*",
    "@langfuse/otel": "^5.9.1",
    "@langfuse/tracing": "^5.9.1",
    "@opentelemetry/sdk-node": "^0.220.0",
    "better-sqlite3": "^11.5.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.9.0",
    "mqtt": "^5.15.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
